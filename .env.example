# Copy to .env for Docker Compose. Use unique passwords before entering real data.
POSTGRES_PASSWORD=local-prototype-only
STAFF_EMAIL=staff@givingflow.local
STAFF_PASSWORD=GivingFlow123!
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
# For native development, set DATABASE_URL in your shell.
# DATABASE_URL=postgresql+psycopg://givingflow:local-prototype-only@localhost:55432/givingflow

# Admin deletion is disabled until a password hash is configured locally.
# Run scripts/Set-AdminDeletionPassword.ps1; never commit the password or hash.
ADMIN_DELETE_PASSWORD_HASH=
